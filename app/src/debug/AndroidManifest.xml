<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds talk to a development server, which may be plain http on the local network. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 17 asks before an app reaches a private address like 10.0.2.2. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application android:networkSecurityConfig="@xml/network_security_config">

        <!-- Shows a push without Firebase, from adb only (DUMP is the shell's). -->
        <receiver
            android:name=".push.DebugPushReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

    </application>
</manifest>
