{
  "settings": {},
  "rules": [
    {
      "patterns": [
        ".*"
      ],
      "properties": {
        "context": "default",
        "pull_to_refresh_enabled": true,
        "uri": "hotwire://fragment/web"
      }
    },
    {
      "patterns": [
        "/new(\\?|$)",
        "/edit(\\?|$)"
      ],
      "properties": {
        "context": "modal",
        "pull_to_refresh_enabled": false,
        "uri": "hotwire://fragment/web/modal"
      }
    },
    {
      "patterns": [
        "^/users/sign_in(\\?|$)",
        "^/users/sign_up(\\?|$)",
        "^/users(\\?|$)",
        "^/users/password(/new|/edit)?(\\?|$)",
        "^/users/confirmation(/new|/sent)?(\\?|$)",
        "^/users/unlock(/new)?(\\?|$)"
      ],
      "properties": {
        "context": "modal",
        "pull_to_refresh_enabled": false,
        "uri": "hotwire://fragment/web/modal"
      }
    },
    {
      "patterns": [
        "/chats/new(\\?|$)",
        "/chats/\\d+(\\?|#|$)"
      ],
      "properties": {
        "context": "default",
        "presentation": "replace_root",
        "pull_to_refresh_enabled": false,
        "uri": "hotwire://fragment/web"
      }
    },
    {
      "patterns": [
        "^/shared/"
      ],
      "properties": {
        "context": "default",
        "pull_to_refresh_enabled": false,
        "uri": "hotwire://fragment/web"
      }
    },
    {
      "patterns": [
        "/settings(\\?|$)"
      ],
      "properties": {
        "context": "modal",
        "pull_to_refresh_enabled": true,
        "uri": "hotwire://fragment/web/modal"
      }
    },
    {
      "patterns": [
        "/chats(\\?|$)",
        "/projects(\\?|$)",
        "/bots(\\?|$)"
      ],
      "properties": {
        "context": "default",
        "pull_to_refresh_enabled": true,
        "uri": "hotwire://fragment/web"
      }
    },
    {
      "patterns": [
        "/chats/\\d+/files/"
      ],
      "properties": {
        "context": "modal",
        "pull_to_refresh_enabled": false,
        "uri": "hotwire://fragment/web/modal"
      }
    },
    {
      "patterns": [
        "^/rails/active_storage/",
        "^/$",
        "^/(pricing|security|self-hosted|imprint|privacy-policy|terms-of-service|survey)(\\?|$)",
        "^/(compare|use-cases|integrations)(/|\\?|$)",
        "^/(robots\\.txt|llms\\.txt|llms-full\\.txt|sitemap\\.xml)(\\?|$)"
      ],
      "properties": {
        "presentation": "none",
        "open_in_browser": true
      }
    }
  ]
}
