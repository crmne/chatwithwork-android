<?xml version="1.0" encoding="utf-8"?>
<!--
  A web screen, chat, page, or modal: the page with the native composer floating over chat pages
  (hidden elsewhere), and over it the top bar every screen shares (TopBar): no surface or hairline,
  its title and buttons on top_fade, which fades what scrolls up into the canvas. The page runs under
  the bar where it keeps clear of it, and starts below it elsewhere (TopBar moves it). The ids are
  Hotwire Native's: it finds the toolbar (titles from the page's <title>) and the hotwire_view (the
  shared web view, progress, and error states).
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    tools:ignore="Overdraw">

    <com.chatwithwork.app.composer.KeyboardSwipeLayout
        android:id="@+id/page_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/composer_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include layout="@layout/hotwire_view" />
        </FrameLayout>

        <!-- Clear gutters let the conversation show through around the composer. -->
        <include
            layout="@layout/view_composer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom" />

    </com.chatwithwork.app.composer.KeyboardSwipeLayout>

    <!-- Reaches past the bar: the last of the fade softens the page's edge. -->
    <View
        android:id="@+id/top_fade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/app_bar"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="@dimen/top_fade_overhang"
        android:importantForAccessibility="no" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_bar_height" />

    </com.google.android.material.appbar.AppBarLayout>

</RelativeLayout>
