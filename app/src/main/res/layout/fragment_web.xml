<?xml version="1.0" encoding="utf-8"?>
<!--
  A web screen: the native top app bar, a hairline, and the page with the
  native composer floating over chat pages (hidden elsewhere). The ids
  are Hotwire Native's: it finds the toolbar (titles from the page's <title>)
  and the hotwire_view (the shared web view, progress, and error states).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    tools:ignore="Overdraw"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />

    </com.google.android.material.appbar.AppBarLayout>

    <View
        android:id="@+id/toolbar_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/composer_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include layout="@layout/hotwire_view" />
        </FrameLayout>

        <!-- Clear gutters let the conversation show through around the composer. -->
        <include
            layout="@layout/view_composer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom" />

    </FrameLayout>

</LinearLayout>
