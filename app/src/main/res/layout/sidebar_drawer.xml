<?xml version="1.0" encoding="utf-8"?>
<!--
  The sidebar: Material 3's modal navigation drawer, drawn with Live Wire's
  sunken canvas like the web's sidebar. The list scrolls (Decisions, the Chats | Bots
  switch, list switcher, New chat, Instructions, pins, search, chats, or the bots); the person stays at the foot. SidebarDrawer fills it from the
  server's JSON.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sidebar"
    android:layout_width="@dimen/sidebar_width"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:clickable="true"
    android:focusable="false"
    android:orientation="vertical"
    android:background="@drawable/sidebar_background">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sidebar_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <LinearLayout
        android:id="@+id/sidebar_person"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/sidebar_person_initials"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/sidebar_avatar"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/lw_ink"
            tools:text="MH" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sidebar_person_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                tools:text="Maya Hart" />

            <TextView
                android:id="@+id/sidebar_person_organization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Northwind Studio" />

        </LinearLayout>

        <ImageView
            android:id="@+id/sidebar_person_more"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_expand_more"
            app:tint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</LinearLayout>
