<?xml version="1.0" encoding="utf-8"?>
<!-- The Bots view with no bots at all: what shows up here, and New bot spelled out. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingTop="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sidebar_no_bots"
        android:textColor="@color/lw_ink_faint"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/sidebar_bots_new"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/sidebar_primary"
        android:drawablePadding="6dp"
        android:focusable="true"
        android:fontFamily="@font/geist_medium"
        app:fontFamily="@font/geist_medium"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="@string/new_bot"
        android:textColor="@color/lw_ink_inverted"
        android:textSize="13sp" />

</LinearLayout>
