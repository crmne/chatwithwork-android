<?xml version="1.0" encoding="utf-8"?>
<!--
  A bot in the sidebar's Bots view, as the web's (bots/_sidebar_bot): its
  mark as tall as its two lines, in its colour with the face of its state,
  and a live dot while one of its chats answers. The first line: its name,
  a shared bot's project icon, and at its end when it last did something,
  in mono. The second: what waits for the person, that it failed, works or
  is paused, in its state's ink, else what its latest run did; and at its
  end how many decisions wait for them in it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sidebar_row_background"
    android:baselineAligned="false"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="7dp">

    <FrameLayout
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no">

        <ImageView
            android:id="@+id/sidebar_bot_mark"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="center" />

        <View
            android:id="@+id/sidebar_bot_live"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-1dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/sidebar_live_ring"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.chatwithwork.app.sidebar.SidebarFitRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sidebar_bot_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/geist_medium"
                android:maxLines="1"
                android:textColor="@color/lw_ink"
                android:textSize="14sp"
                tools:text="Morning briefing" />

            <ImageView
                android:id="@+id/sidebar_bot_project"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:scaleType="center"
                android:visibility="gone"
                tools:visibility="visible" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/sidebar_bot_when"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/geist_mono_medium"
                android:maxLines="1"
                android:textColor="@color/lw_ink_faint"
                android:textSize="11sp"
                tools:text="08:30" />

        </com.chatwithwork.app.sidebar.SidebarFitRow>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sidebar_bot_line"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/geist_regular"
                android:maxLines="1"
                android:textColor="@color/lw_ink_faint"
                android:textSize="12sp"
                tools:text="Sent the brief to #general" />

            <TextView
                android:id="@+id/sidebar_bot_count"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/sidebar_decisions_count"
                android:fontFamily="@font/geist_mono_medium"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:minWidth="18dp"
                android:paddingHorizontal="5dp"
                android:textColor="@color/lw_attention_ink"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="2"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
