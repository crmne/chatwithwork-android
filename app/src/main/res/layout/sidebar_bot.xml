<?xml version="1.0" encoding="utf-8"?>
<!--
  A bot in the sidebar's Bots view, as the web's (bots/_sidebar_bot): its
  mark, with a live dot while one of its chats answers, its name, the
  project a shared bot is in, and at its end its state: how many decisions
  wait in it, or its state's words with a dot in the state's colour.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@drawable/sidebar_row_background"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">

    <FrameLayout
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no">

        <ImageView
            android:id="@+id/sidebar_bot_mark"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="center" />

        <View
            android:id="@+id/sidebar_bot_live"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-3dp"
            android:layout_marginBottom="-2dp"
            android:background="@drawable/sidebar_live_ring"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

    <TextView
        android:id="@+id/sidebar_bot_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface"
        tools:text="Morning briefing" />

    <TextView
        android:id="@+id/sidebar_bot_project"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:maxWidth="88dp"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:text="Engineering"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/sidebar_bot_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:maxWidth="104dp"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Next 08:30" />

    <View
        android:id="@+id/sidebar_bot_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/sidebar_dot"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
