<?xml version="1.0" encoding="utf-8"?>
<!--
  A bot in the sidebar's Bots view, as the web's (bots/_sidebar_bot): its
  mark, with a live dot while one of its chats answers, its name, a shared
  bot's project icon, and at its end its one state: a dot and how many
  decisions wait in it, Failed, Paused, or when a time next starts it.
-->
<com.chatwithwork.app.sidebar.SidebarFitRow xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="35dp"
    android:background="@drawable/sidebar_row_background"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp">

    <FrameLayout
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no">

        <ImageView
            android:id="@+id/sidebar_bot_mark"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="center" />

        <View
            android:id="@+id/sidebar_bot_live"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-3dp"
            android:layout_marginBottom="-2dp"
            android:background="@drawable/sidebar_live_ring"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

    <TextView
        android:id="@+id/sidebar_bot_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/lw_ink_muted"
        android:textSize="14sp"
        tools:text="Morning briefing" />

    <ImageView
        android:id="@+id/sidebar_bot_project"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="10dp"
        android:importantForAccessibility="no"
        android:scaleType="center"
        android:visibility="gone"
        tools:visibility="visible" />

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:id="@+id/sidebar_bot_dot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/sidebar_dot"
        android:backgroundTint="@color/lw_attention"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/sidebar_bot_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:maxLines="1"
        android:textColor="@color/lw_ink_faint"
        android:textSize="12sp"
        tools:text="08:30" />

</com.chatwithwork.app.sidebar.SidebarFitRow>
