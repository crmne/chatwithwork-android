    <color name="ripple">#1FE9ECF4</color>
    <color name="lw_negative_ink">#FF7F61</color>
    <!-- Allow everything's pill (tokens.css: negative-wash, negative-edge, their color-mix computed in oklab). -->
    <color name="lw_negative_wash">#241B20</color>
    <color name="lw_negative_edge">#7C4340</color>
    <!-- The composer's buttons, as the web composer's on touch screens (composer.css, buttons.css): a ghost or
         subtle button pressed is ink at 7% or the hover surface, ink pressed is mixed lighter; Send with nothing
         to send (.btn-disabled-visual) is ink at 5% under an icon at 14%, and Stopping is ink at 10% under 20%;
         listening is live at 12% inside live at 40%. -->
    <color name="composer_pressed">#12E9ECF4</color>
    <color name="composer_ink_pressed">#BFC2C9</color>
    <color name="composer_send_disabled">#0DE9ECF4</color>
    <color name="composer_send_disabled_icon">#24E9ECF4</color>
    <color name="composer_stop_disabled">#1AE9ECF4</color>
    <color name="composer_stop_disabled_icon">#33E9ECF4</color>
    <color name="composer_listening">#1F44B0FF</color>
    <color name="composer_listening_edge">#6644B0FF</color>
    <color name="composer_toggle_on">#1AE9ECF4</color>
    <color name="composer_toggle_on_pressed">#2BE9ECF4</color>
    <color name="composer_toggle_shadow">#1FE9ECF4</color>
    <color name="composer_toggle_shadow_edge">#0DE9ECF4</color>
    <!-- A file chip's remove button pressed, as the web's hovered .attachment__remove: ink at 8%. -->
    <color name="composer_remove_pressed">#14E9ECF4</color>
</resources>
