<?xml version="1.0" encoding="utf-8"?>
<!--
  Live Wire, the web app's design tokens (app/assets/tailwind/base/tokens.css
  in the Rails app), light theme. values-night holds the dark theme. Keep the
  two in step with the web: the native bars sit right against web content.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="UnusedResources">
    <color name="lw_canvas">#F3F5F9</color>
    <color name="lw_canvas_sunken">#EAEEF4</color>
    <color name="lw_surface">#FFFFFF</color>
    <color name="lw_surface_raised">#FFFFFF</color>
    <color name="lw_surface_hover">#F1F4F8</color>
    <color name="lw_surface_selected">#E7EBF2</color>
    <!-- The shimmer over a loading chat's bones (lw_surface_selected): one step lighter than them. -->
    <color name="skeleton_highlight">@color/lw_surface</color>
    <color name="lw_ink">#0A0D14</color>
    <color name="lw_ink_muted">#5A6374</color>
    <color name="lw_ink_faint">#616A7E</color>
    <color name="lw_ink_inverted">#FFFFFF</color>
    <color name="lw_line">#D6DCE7</color>
    <color name="lw_line_strong">#C3CBDA</color>
    <color name="lw_positive">#13C977</color>
    <color name="lw_positive_ink">#0A8A50</color>
    <color name="lw_live">#1E8FE6</color>
    <color name="lw_live_ink">#1569B5</color>
    <color name="lw_attention">#D99A06</color>
    <color name="lw_attention_ink">#8A5F00</color>
    <!-- A decision waiting: the attention wash and its edge (tokens.css: attention-wash, attention-edge). -->
    <color name="lw_attention_wash">#F9EFD7</color>
    <color name="lw_attention_edge">#D7C088</color>
    <color name="lw_negative">#F0552F</color>
    <!-- tokens.css: shadow-color, 28% and 90%, for the composer's shadow-float. -->
    <color name="lw_shadow">#47141E3C</color>
    <color name="lw_dot">#1A0A0D14</color>
    <!-- Over the page while the sidebar is open: Material's scrim, in ink. -->
    <!-- The sidebar's row for the page showing, on its sunken canvas. -->
    <color name="scrim">#470A0D14</color>
    <color name="ripple">#1A0A0D14</color>
    <color name="lw_negative_ink">#C93A17</color>

    <!-- The canvas of each theme, for browser tabs that pick their own. -->
    <!-- Ink at 3%, the Chats | Bots track. -->
    <color name="sidebar_views_track">#080A0D14</color>
    <color name="lw_canvas_light_mode">#F3F5F9</color>
    <color name="lw_canvas_dark_mode">#06070B</color>

    <!-- The mark's own colors, the same in both themes. -->
    <color name="mark_bubble">#FFFFFF</color>
    <color name="mark_scribble">#000000</color>
    <!-- The bot on a Live Update's road: outlined only where the shade is light. -->
    <color name="icon_background">#06070B</color>
    <!-- The Open Road card: fixed, with no light variant, as the iOS card is always dark. -->
    <color name="road_canvas">#06070B</color>
    <color name="road_ink">#E9ECF4</color>
    <color name="road_ink_muted">#8D96AA</color>
    <color name="road_grey">#4A5264</color>
    <color name="road_line">#39404F</color>
    <color name="road_plinth">#141824</color>
    <color name="road_attention">#FFC247</color>
    <color name="road_positive">#44FF9A</color>
    <color name="road_negative">#FF7F61</color>
    <color name="road_quiet">#2A3040</color>
    <color name="road_dimmed_ahead">#6B7488</color>
    <color name="road_dim">#AEB6C8</color>
    <color name="road_attention_wash">#2B2315</color>
    <color name="road_attention_edge">#6C5322</color>
    <color name="road_negative_wash">#291714</color>
    <color name="road_negative_edge">#612A1F</color>
    <!-- The composer's buttons, as the web composer's on touch screens (composer.css, buttons.css): a ghost or
         subtle button pressed is ink at 7% or the hover surface, ink pressed is mixed lighter; Send with nothing
         to send (.btn-disabled-visual) is ink at 5% under an icon at 14%, and Stopping is ink at 10% under 20%;
         listening is live at 12% inside live at 40%. -->
    <color name="composer_pressed">#120A0D14</color>
    <color name="composer_ink_pressed">#282B32</color>
    <color name="composer_send_disabled">#0D0A0D14</color>
    <color name="composer_send_disabled_icon">#240A0D14</color>
    <color name="composer_stop_disabled">#1A0A0D14</color>
    <color name="composer_stop_disabled_icon">#330A0D14</color>
    <color name="composer_listening">#1F1E8FE6</color>
    <color name="composer_listening_edge">#661E8FE6</color>
    <!-- The globe switched on (.chat-prompt__web-search-toggle[aria-pressed=true]): ink at 10%, and its inset
         shadow of ink at 12%, blurred to about 5% round the edge. -->
    <color name="composer_toggle_on">#1A0A0D14</color>
    <color name="composer_toggle_on_pressed">#2B0A0D14</color>
    <color name="composer_toggle_shadow">#1F0A0D14</color>
    <color name="composer_toggle_shadow_edge">#0D0A0D14</color>
    <!-- A file chip's remove button pressed, as the web's hovered .attachment__remove: ink at 8%. -->
    <color name="composer_remove_pressed">#140A0D14</color>
</resources>
