    <dimen name="top_bar_button_inset">4dp</dimen>
    <dimen name="top_bar_edge">8dp</dimen>
    <dimen name="top_bar_button_stroke">1dp</dimen>
    <dimen name="top_bar_button_elevation">3dp</dimen>
    <dimen name="top_bar_text_action_padding">16dp</dimen>
