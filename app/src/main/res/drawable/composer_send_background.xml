<?xml version="1.0" encoding="utf-8"?>
<!-- The web's Send on touch screens (.btn-primary.btn-square in .chat-prompt__bar): a 34dp ink square with 9dp corners inside its 44dp target, lighter pressed, and nearly clear with nothing to send (.btn-disabled-visual). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <inset android:inset="5dp">
            <shape>
                <solid android:color="@color/composer_send_disabled" />
                <corners android:radius="9dp" />
            </shape>
        </inset>
    </item>
    <item android:state_pressed="true">
        <inset android:inset="5dp">
            <shape>
                <solid android:color="@color/composer_ink_pressed" />
                <corners android:radius="9dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:inset="5dp">
            <shape>
                <solid android:color="@color/lw_ink" />
                <corners android:radius="9dp" />
            </shape>
        </inset>
    </item>
</selector>
