<?xml version="1.0" encoding="utf-8"?>
<!-- The web's touch send button (.chat-prompt__send): a 36dp square with 10dp corners inside its 44dp target. Ink when there's something to send (or an answer to stop), the quiet surface otherwise. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector>
            <item android:state_enabled="false">
                <inset android:inset="4dp">
                    <shape>
                        <solid android:color="@color/lw_surface_hover" />
                        <corners android:radius="10dp" />
                    </shape>
                </inset>
            </item>
            <item>
                <inset android:inset="4dp">
                    <shape>
                        <solid android:color="@color/lw_ink" />
                        <corners android:radius="10dp" />
                    </shape>
                </inset>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <inset android:inset="4dp">
            <shape>
                <solid android:color="@android:color/white" />
                <corners android:radius="10dp" />
            </shape>
        </inset>
    </item>
</ripple>
