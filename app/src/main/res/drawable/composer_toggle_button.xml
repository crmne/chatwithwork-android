<?xml version="1.0" encoding="utf-8"?>
<!-- The globe in the composer's bar as the web draws it on a touch screen (.chat-prompt__web-search-toggle,
     web_search.css, over composer.css's touch .btn-square), measured in a phone browser: clear when off, ink at 7%
     pressed, as composer_ghost_button. Switched on, the 34dp square takes ink at 10% with 5dp corners (the toggle's
     10px radius inside its 1px edge and 4px padding), the touch bar hides the strong line, and the inset shadow
     (0 1px 2px, ink at 12%) falls round the 44dp target's inner edge, heaviest at the top. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <!-- The inset shadow: the web draws it inside the button's 1px edge, round the 44px target. -->
            <item
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape>
                    <stroke android:width="1dp" android:color="@color/composer_toggle_shadow_edge" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
            <item
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape>
                    <gradient
                        android:angle="270"
                        android:centerColor="@android:color/transparent"
                        android:centerY="0.08"
                        android:endColor="@android:color/transparent"
                        android:startColor="@color/composer_toggle_shadow" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
            <item
                android:bottom="5dp"
                android:left="5dp"
                android:right="5dp"
                android:top="5dp">
                <shape>
                    <solid android:color="@color/composer_toggle_on" />
                    <corners android:radius="5dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <inset android:inset="5dp">
            <shape>
                <solid android:color="@color/composer_pressed" />
                <corners android:radius="9dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:inset="5dp">
            <shape>
                <solid android:color="@android:color/transparent" />
                <corners android:radius="9dp" />
            </shape>
        </inset>
    </item>
</selector>
