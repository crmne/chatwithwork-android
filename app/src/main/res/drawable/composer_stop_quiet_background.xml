<?xml version="1.0" encoding="utf-8"?>
<!-- Stop beside Send while an answer runs: outlined, so Send stays the one ink button; the quiet surface when disabled. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape>
                    <solid android:color="@color/lw_surface_hover" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="1dp" android:color="@color/lw_line_strong" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
