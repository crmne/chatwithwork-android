<?xml version="1.0" encoding="utf-8"?>
<!-- Stop beside Send while an answer runs, the same square: outlined, so Send stays the one ink button; the quiet surface when disabled. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector>
            <item android:state_enabled="false">
                <inset android:inset="4dp">
                    <shape>
                        <solid android:color="@color/lw_surface_hover" />
                        <corners android:radius="10dp" />
                    </shape>
                </inset>
            </item>
            <item>
                <inset android:inset="4dp">
                    <shape>
                        <solid android:color="@android:color/transparent" />
                        <stroke android:width="1dp" android:color="@color/lw_line_strong" />
                        <corners android:radius="10dp" />
                    </shape>
                </inset>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <inset android:inset="4dp">
            <shape>
                <solid android:color="@android:color/white" />
                <corners android:radius="10dp" />
            </shape>
        </inset>
    </item>
</ripple>
