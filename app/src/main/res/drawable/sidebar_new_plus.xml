<?xml version="1.0" encoding="utf-8"?>
<!--
  The + on New chat's and New bot's mark (.sidebar__new-plus): a small disc of
  ink, cut out of the mark by a ring of the card's colour.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/lw_surface" />
        </shape>
    </item>
    <item android:bottom="1.5dp" android:left="1.5dp" android:right="1.5dp" android:top="1.5dp">
        <shape android:shape="oval">
            <solid android:color="@color/lw_ink" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:drawable="@drawable/ic_sidebar_new_plus_glyph"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp" />
</layer-list>
