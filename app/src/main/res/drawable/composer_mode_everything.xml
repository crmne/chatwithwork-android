<?xml version="1.0" encoding="utf-8"?>
<!-- The composer's mode pill for Allow everything: the negative wash inside its negative edge, hard to miss, ink at 7% more pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetTop="5dp" android:insetBottom="5dp">
            <layer-list>
                <item>
                    <shape>
                        <solid android:color="@color/lw_negative_wash" />
                        <stroke android:width="1dp" android:color="@color/lw_negative_edge" />
                        <corners android:radius="17dp" />
                    </shape>
                </item>
                <item>
                    <shape>
                        <solid android:color="@color/composer_pressed" />
                        <corners android:radius="17dp" />
                    </shape>
                </item>
            </layer-list>
        </inset>
    </item>
    <item>
        <inset android:insetTop="5dp" android:insetBottom="5dp">
            <shape>
                <solid android:color="@color/lw_negative_wash" />
                <stroke android:width="1dp" android:color="@color/lw_negative_edge" />
                <corners android:radius="17dp" />
            </shape>
        </inset>
    </item>
</selector>
