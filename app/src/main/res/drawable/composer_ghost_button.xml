<?xml version="1.0" encoding="utf-8"?>
<!-- The web composer's ghost button on touch screens (.btn-ghost.btn-square in .chat-prompt__bar): a 34dp square with 9dp corners inside its 44dp target, clear at rest, ink at 7% pressed; switched on (files attached, web search on) it takes the line inside its edge. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:inset="5dp">
            <shape>
                <solid android:color="@color/composer_pressed" />
                <corners android:radius="9dp" />
            </shape>
        </inset>
    </item>
    <item android:state_selected="true">
        <inset android:inset="5dp">
            <shape>
                <solid android:color="@android:color/transparent" />
                <stroke android:width="1dp" android:color="@color/lw_line_strong" />
                <corners android:radius="9dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:inset="5dp">
            <shape>
                <solid android:color="@android:color/transparent" />
                <corners android:radius="9dp" />
            </shape>
        </inset>
    </item>
</selector>
