<?xml version="1.0" encoding="utf-8"?>
<!-- One half of the Chats | Bots switch: raised on the surface when it's the one chosen. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="@android:color/white" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/lw_surface" />
                    <stroke android:width="1dp" android:color="@color/lw_line" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
            <item>
                <color android:color="@android:color/transparent" />
            </item>
        </selector>
    </item>
</ripple>
