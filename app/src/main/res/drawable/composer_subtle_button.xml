<?xml version="1.0" encoding="utf-8"?>
<!-- Send beside Stop while an answer runs (.btn-subtle.btn-square in .chat-prompt__bar, whose hairline the touch bar hides): the surface, the hover surface pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <inset android:inset="5dp">
            <shape>
                <solid android:color="@color/composer_send_disabled" />
                <corners android:radius="9dp" />
            </shape>
        </inset>
    </item>
    <item android:state_pressed="true">
        <inset android:inset="5dp">
            <shape>
                <solid android:color="@color/lw_surface_hover" />
                <corners android:radius="9dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:inset="5dp">
            <shape>
                <solid android:color="@color/lw_surface" />
                <corners android:radius="9dp" />
            </shape>
        </inset>
    </item>
</selector>
