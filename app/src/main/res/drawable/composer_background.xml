<?xml version="1.0" encoding="utf-8"?>
<!-- The composer's rainbow edge (Live Wire's rainbow), then the surface inside it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:centerColor="#8B44FF"
                android:endColor="#EBFF70"
                android:startColor="#44FF9A"
                android:type="linear" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape>
            <solid android:color="@color/lw_surface" />
            <corners android:radius="20.5dp" />
        </shape>
    </item>
</layer-list>
