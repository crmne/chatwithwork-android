<?xml version="1.0" encoding="utf-8"?>
<!-- The microphone while it listens (.chat-prompt__dictate[aria-pressed]): live at 12% inside live at 40%, never the rainbow. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <inset android:inset="5dp">
            <shape>
                <solid android:color="@color/composer_listening" />
                <stroke android:width="1dp" android:color="@color/composer_listening_edge" />
                <corners android:radius="9dp" />
            </shape>
        </inset>
    </item>
</selector>
