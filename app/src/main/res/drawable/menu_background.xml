<?xml version="1.0" encoding="utf-8"?>
<!-- Menus: the raised surface with a hairline, like the web's dropdowns. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/lw_surface_raised" />
    <stroke
        android:width="1dp"
        android:color="@color/lw_line" />
    <corners android:radius="12dp" />
    <padding
        android:bottom="6dp"
        android:top="6dp" />
</shape>
