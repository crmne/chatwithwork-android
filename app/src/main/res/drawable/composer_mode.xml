<?xml version="1.0" encoding="utf-8"?>
<!-- The composer's mode pill for Allow edits: a clear 34dp pill in its 44dp target with a 1dp strong line, ink at 7% pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetTop="5dp" android:insetBottom="5dp">
            <shape>
                <solid android:color="@color/composer_pressed" />
                <stroke android:width="1dp" android:color="@color/lw_line_strong" />
                <corners android:radius="17dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetTop="5dp" android:insetBottom="5dp">
            <shape>
                <solid android:color="@android:color/transparent" />
                <stroke android:width="1dp" android:color="@color/lw_line_strong" />
                <corners android:radius="17dp" />
            </shape>
        </inset>
    </item>
</selector>
