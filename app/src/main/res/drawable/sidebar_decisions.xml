<?xml version="1.0" encoding="utf-8"?>
<!--
  The sidebar's Decisions button, outlined like the list switcher (sidebar_card,
  the web's decisions_button.css): its ring takes the attention edge while
  something waits (state_activated), and the selected surface while the
  Decisions page shows.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector>
            <item android:state_activated="true" android:state_selected="true">
                <shape>
                    <solid android:color="@color/lw_surface_selected" />
                    <stroke android:width="1dp" android:color="@color/lw_attention_edge" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:state_activated="true">
                <shape>
                    <solid android:color="@color/lw_surface" />
                    <stroke android:width="1dp" android:color="@color/lw_attention_edge" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/lw_surface_selected" />
                    <stroke android:width="1dp" android:color="@color/lw_line" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/lw_surface" />
                    <stroke android:width="1dp" android:color="@color/lw_line" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
