#!/usr/bin/env bash
# Builds the release App Bundle for Google Play from a vX.Y.Z tag, signed
# with the upload key from 1Password (script/upload-key made it), numbering
# the build MAJOR*10000 + MINOR*100 + PATCH (v1.2.3 is 10203).
#
#   script/bundle-release              # HEAD must be at a vX.Y.Z tag
#   script/bundle-release v1.2.3
#
# Writes app/build/outputs/bundle/release/app-release.aab.
set -euo pipefail
cd "$(dirname "$0")/.."

tag="${1:-$(git describe --tags --exact-match 2>/dev/null || true)}"
version="${tag#v}"
if [[ ! "$version" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
  echo "Give a stable tag like v1.2.3 (HEAD isn't at one)." >&2
  exit 1
fi
code=$((BASH_REMATCH[1] * 10000 + BASH_REMATCH[2] * 100 + BASH_REMATCH[3]))

vault="${VAULT:-chatwithwork}"
dir="$(mktemp -d)"
trap 'rm -rf "$dir"' EXIT
chmod 700 "$dir"

# op-cache returns text, so the keystore is kept base64-encoded.
op-cache read "op://$vault/${ITEM:-Android upload key}/keystore_base64" | base64 -d > "$dir/upload.jks"
RELEASE_KEYSTORE_PASSWORD="$(op-cache read "op://$vault/${ITEM:-Android upload key}/password")"
export RELEASE_KEYSTORE_PATH="$dir/upload.jks" RELEASE_KEY_ALIAS=upload
export RELEASE_KEYSTORE_PASSWORD RELEASE_KEY_PASSWORD="$RELEASE_KEYSTORE_PASSWORD"

./gradlew bundleRelease -PversionName="$version" -PversionCode="$code"

aab=app/build/outputs/bundle/release/app-release.aab
jarsigner -verify "$aab" >/dev/null && echo "Signed $aab: $version ($code)"
